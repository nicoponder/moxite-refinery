{
  "manifest_version": 2,
  "name": "Moxite Refinery",
  "version": "0.1",

  "description": "Adds functionality to Moxfield",

  "icons": {
    "48": "icons/border-48.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "@moxite-refinery",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },

  "content_scripts": [
    {
      "matches": ["*://moxfield.com/decks/"],
      "js": ["refinery.js"]
    }
  ]
}
