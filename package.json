{
  "name": "moxite-refinery",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build && npm run zip",
    "zip": "rm -f \"Moxite Refinery.zip\" && cd dist && zip -qrX \"../Moxite Refinery.zip\" . -x \".DS_Store\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "tsc --noEmit && oxlint && oxfmt --check",
    "test": "vite build && playwright test",
    "bump": "node scripts/bump-version.mjs",
    "sign": "sh scripts/sign.sh"
  },
  "dependencies": {
    "@stdlib/stats-base-dists-hypergeometric-pmf": "^0.3.1",
    "colord": "^2.10.0",
    "jotai": "^3.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
